+    /// The pixels of the frame last shown, once a readback of it has completed; `None` while it is
+    /// in flight (one is started if none is).
+    fn read_last_frame(&mut self) -> Option<(u32, u32, Vec<u8>)> {
+        let _ = self.resources.device.poll(wgpu::Maintain::Poll);
+        if let Some((readback, state)) = &self.last_frame_readback {
+            match state.load(Ordering::Acquire) {
+                READBACK_PENDING => return None,
+                READBACK_MAPPED => {
+                    let rgba = readback.read_mapped_rgba8();
+                    let frame = (readback.width, readback.height, rgba);
+                    self.last_frame_readback = None;
+                    return Some(frame);
+                }
+                _ => log::warn!("frame readback failed; retrying"),
+            }
+        }
+        let mut encoder = self.resources.device.create_command_encoder(
+            &wgpu::CommandEncoderDescriptor { label: Some("rfvp last frame readback") },
+        );
+        let readback = self
+            .render_target
+            .encode_readback_rgba8(&self.resources.device, &mut encoder);
+        self.resources.queue.submit(Some(encoder.finish()));
+        let state = readback.begin_map();
+        self.last_frame_readback = Some((readback, state));
+        None
+    }
+
+    /// Finishes a frame that was waiting on `last_frame_readback`; false when none was.
