+/// Scales the game's own screen (its Gameexe size, kept as the logical size) into the canvas,
+/// centred with black bars, as the Android and iOS hosts do.
+fn fit_viewport(host: &mut SiglusHost, surface_w: u32, surface_h: u32, scale_factor: f32) {
+    let (sw, sh) = (surface_w.max(1), surface_h.max(1));
+    let (lw, lh) = host.logical_size();
+    let scale = (sw as f64 / lw as f64).min(sh as f64 / lh as f64);
+    let vw = ((lw as f64 * scale).round() as u32).clamp(1, sw);
+    let vh = ((lh as f64 * scale).round() as u32).clamp(1, sh);
+    host.resize_with_logical_viewport(sw, sh, scale_factor, lw, lh, (sw - vw) / 2, (sh - vh) / 2, vw, vh);
+}
+
+/// Maps a pointer position in canvas pixels to game screen coordinates.
+fn to_game(host: &mut SiglusHost, x: f64, y: f64) -> (f64, f64) {
+    let (vx, vy, vw, vh) = host.renderer_mut().surface_viewport();
+    let (lw, lh) = host.logical_size();
+    (
+        ((x - vx as f64) / vw.max(1) as f64 * lw as f64).clamp(0.0, lw as f64),
+        ((y - vy as f64) / vh.max(1) as f64 * lh as f64).clamp(0.0, lh as f64),
+    )
+}
