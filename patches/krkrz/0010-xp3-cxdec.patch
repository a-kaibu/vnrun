+// Validate a candidate against complete entries before using it. Plugin names
+// alone cannot identify trial/release variants of cxdec.
+bool tTVPXP3Archive::DetectCxdec()
+{
+ const struct { const tjs_char *file; vnrun::CxScheme scheme; } candidates[] = {
+  {TJS_W("plugin/yuyukana.tpm"), vnrun::CxYuyukana},
+  {TJS_W("plugin/lavender.tpm"), vnrun::CxLavender},
+  {TJS_W("plugin/lavender.tpm"), {0x181,0x635,{{2,1,0}},{{4,0,1,5,2,3}},{{7,5,2,3,6,1,4,0}}}},
+ };
+ for(const auto &candidate : candidates)
+ {
+  try
+  {
+   ttstr path = TVPExtractStoragePath(Name) + candidate.file;
+   if(!TVPIsExistentStorageNoSearch(path)) continue;
+   tTVPStreamHolder plugin(path);
+   auto size = plugin->GetSize();
+   if(size < 4096 || size > 4*1024*1024) continue;
+   std::vector<tjs_uint8> data((size_t)size);
+   plugin->ReadBuffer(data.data(), (tjs_uint)size);
+   size_t at = 0;
+   for(; at + 4096 <= data.size(); at += 4)
+    if(!memcmp(data.data()+at," Encryption control block",25)) break;
+   if(at + 4096 > data.size()) continue;
+   std::unique_ptr<vnrun::Cxdec> decoder(new vnrun::Cxdec(candidate.scheme,data.data()+at));
+   unsigned valid = 0;
+   for(tjs_uint i=0;i<ItemVector.size() && valid<2;++i)
+   {
+    const auto &item=ItemVector[i];
+    if(!item.Protected || item.OrgSize<16 || item.OrgSize>1024*1024) continue;
+    std::vector<tjs_uint8> bytes((size_t)item.OrgSize);
+    std::unique_ptr<tTJSBinaryStream> stream(CreateStreamByIndex(i));
+    stream->ReadBuffer(bytes.data(),(tjs_uint)bytes.size());
+    decoder->decrypt(item.FileHash,0,bytes.data(),bytes.size());
+    if(adler32(adler32(0L,Z_NULL,0),bytes.data(),bytes.size())!=item.FileHash) break;
+    ++valid;
+   }
+   if(valid==2)
+   {
+    Cxdec=std::move(decoder);
+    TVPAddLog(TJS_W("(vnrun) encrypted archive: cxdec (validated)"));
+    return true;
+   }
+  }
+  catch(...) { /* absent or unsupported plugin: try the normal detectors */ }
+ }
+ return false;
+}
