+// vnrun: reads an entry whole for checking it, false when it can't be read. The notice of
+// protected KiriKiri Z archives lists more bytes than it stores, so reading it fails.
+template <class Open> static bool ReadEntry(Open open, std::vector<tjs_uint8> &out)
+{
+	try {
+		std::unique_ptr<tTJSBinaryStream> stream(open());
+		return stream->Read(out.data(), (tjs_uint)out.size()) == out.size();
+	} catch(...) {
+		return false;
+	}
+}
