+// vnrun: pointer input from the page, in window pixels (the page maps its canvas to the
+// frame). SDL never sees the pointer on its own canvas, so the position is kept here too.
+static int vnrun_mouse_x, vnrun_mouse_y;
+
+EMSCRIPTEN_KEEPALIVE void vnrun_mouse(int x, int y, int button, int down)
+{
+	SDL_Event event;
+	SDL_zero(event);
+	vnrun_mouse_x = x;
+	vnrun_mouse_y = y;
+	if (button == 0) {
+		event.type = SDL_MOUSEMOTION;
+		event.motion.x = x;
+		event.motion.y = y;
+	} else {
+		event.type = down ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+		event.button.button = button;
+		event.button.state = down ? SDL_PRESSED : SDL_RELEASED;
+		event.button.clicks = 1;
+		event.button.x = x;
+		event.button.y = y;
+	}
+	SDL_PushEvent(&event);
+}
+
+EMSCRIPTEN_KEEPALIVE void vnrun_wheel(int dy)
+{
+	SDL_Event event;
+	SDL_zero(event);
+	event.type = SDL_MOUSEWHEEL;
+	event.wheel.y = dy;
+	SDL_PushEvent(&event);
+}
+#endif
+
 void mouse_get_pos(int *x, int *y)
 {
 	int wx, wy;
+#ifdef __EMSCRIPTEN__
+	vnrun_yield(50);
+	wx = vnrun_mouse_x;
+	wy = vnrun_mouse_y;
+#else
 	SDL_PumpEvents();
 	SDL_GetMouseState(&wx, &wy);
+#endif
 	*x = (wx - sdl.viewport.x) * sdl.w / sdl.viewport.w;
 	*y = (wy - sdl.viewport.y) * sdl.h / sdl.viewport.h;
 }
 
 void mouse_set_pos(int x, int y)
 {
+#ifdef __EMSCRIPTEN__
+	vnrun_mouse_x = x * sdl.viewport.w / sdl.w + sdl.viewport.x;
+	vnrun_mouse_y = y * sdl.viewport.h / sdl.h + sdl.viewport.y;
+	return;
+#endif
 	int wx = x * sdl.viewport.w / sdl.w + sdl.viewport.x;
 	int wy = y * sdl.viewport.h / sdl.h + sdl.viewport.y;
 	SDL_WarpMouseInWindow(sdl.window, wx, wy);
