@@ -32,6 +32,49 @@
 #include "icon.h"
 #include "xsystem4.h"
 
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+// vnrun: the page shows each frame itself (WebGPU), so the GL canvas is never on screen.
+extern void vnrun_present(const void *pixels, int pitch, int width, int height);
+
+// Gives the browser a turn (drawing, input, audio) at least every `ms` milliseconds; the VM
+// otherwise runs without returning to it.
+void vnrun_yield(unsigned ms)
+{
+	static uint64_t last;
+	uint64_t now = SDL_GetTicks64();
+	if (now - last >= ms) {
+		emscripten_sleep(0);
+		last = SDL_GetTicks64();
+	}
+}
+
+// Reads the view texture back through a framebuffer of its own: the GL canvas is not on the
+// page, so its size (and so the default framebuffer) means nothing.
+static void vnrun_present_frame(struct texture *t)
+{
+	static GLuint fb;
+	static uint8_t *pixels;
+	static int size;
+	int w = t->w, h = t->h;
+	if (w <= 0 || h <= 0)
+		return;
+	if (w * h * 4 > size) {
+		size = w * h * 4;
+		pixels = xrealloc(pixels, size);
+	}
+	if (!fb)
+		glGenFramebuffers(1, &fb);
+	glBindFramebuffer(GL_FRAMEBUFFER, fb);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, t->handle, 0);
+	glPixelStorei(GL_PACK_ALIGNMENT, 1);
+	glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+	// Textures hold window row 0 first, so the rows come out top first.
+	vnrun_present(pixels, w * 4, w, h);
+}
+#endif
