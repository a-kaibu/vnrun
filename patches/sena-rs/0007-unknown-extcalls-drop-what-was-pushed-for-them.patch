+/// How many values the script pushes (allowing movs between them) right before the
+/// instruction at `pc`.
+fn pushed_before(bytes: &[u8], pc: u32) -> usize {
+    const PUSH: u32 = 0x0001_001F;
+    const MOV: u32 = 0x0001_0001;
+    let word = |at: usize| bytes.get(at..at + 4).map(|w| u32::from_le_bytes([w[0], w[1], w[2], w[3]]));
+    let (mut at, mut count) = (pc as usize, 0);
+    loop {
+        if at >= 8 && word(at - 8) == Some(PUSH) {
+            count += 1;
+            at -= 8;
+        } else if at >= 12 && word(at - 12) == Some(MOV) {
+            at -= 12;
+        } else {
+            return count;
+        }
+    }
+}
