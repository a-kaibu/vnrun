 /// All sections of an INI file, keyed by lowercased section name.
 pub type IniFile = BTreeMap<String, IniSection>;
 
+/// The screen size Game.exe hard-codes, as `push height; push width` for the window.
+/// SYSTEM.INI's DEF_CG size is the CG canvas, which some games make larger than the
+/// screen (巨乳大魔王のドスケベクエスト: 1540x980 CGs on a 1280x720 screen).
+pub fn exe_screen_size(root: &Path) -> Option<(u32, u32)> {
+    const SIZES: [(u32, u32); 6] = [(800, 600), (1024, 576), (1024, 768), (1280, 720), (1600, 900), (1920, 1080)];
+    let mut best = None;
+    let mut best_count = 0;
+    for name in vfs::list_dir(root) {
+        let lower = name.to_ascii_lowercase();
+        if !lower.ends_with(".exe") || lower.starts_with("config") {
+            continue;
+        }
+        let Ok(bytes) = vfs::read_all(&root.join(&name)) else { continue };
+        for (w, h) in SIZES {
+            let mut pattern = vec![0x68];
+            pattern.extend_from_slice(&h.to_le_bytes());
+            pattern.push(0x68);
+            pattern.extend_from_slice(&w.to_le_bytes());
+            let count = bytes.windows(pattern.len()).filter(|win| *win == pattern.as_slice()).count();
+            if count > best_count {
+                best = Some((w, h));
+                best_count = count;
+            }
+        }
+    }
+    best
+}
+
+/// Makes SYSTEM.INI's DEF_CG size, which the engine takes as the screen size, `size`.
+pub fn set_ini_screen_size(ini: &mut IniFile, (width, height): (u32, u32)) {
+    let graphics = ini.entry("graphics".to_owned()).or_default();
+    graphics.insert("def_cg_width".to_owned(), IniValue::Int(width.into()));
+    graphics.insert("def_cg_height".to_owned(), IniValue::Int(height.into()));
+}
