 /// The screen size Game.exe hard-codes, as `push height; push width` for the window.
 /// SYSTEM.INI's DEF_CG size is the CG canvas, which some games make larger than the
+/// The id stamped into Game.exe, which category 18 index 17 returns in the 2011-2012
+/// releases (淫落痴漢電車 体験版 compares it with 6263 and ends otherwise). Game.exe
+/// (sub_403D40 there) reads its own file, finds the last `/**/` marker, checks that the
+/// two halves of the next dword (xor 0xFEFEFDFC) agree, and mixes four of the twelve
+/// bytes after it into the value.
+pub fn exe_stamp(root: &Path) -> Option<i32> {
+    for name in vfs::list_dir(root) {
+        let lower = name.to_ascii_lowercase();
+        if !lower.ends_with(".exe") || lower.starts_with("config") {
+            continue;
+        }
+        let Ok(bytes) = vfs::read_all(&root.join(&name)) else { continue };
+        if let Some(value) = stamp_of(&bytes) {
+            return Some(value);
+        }
+    }
+    None
+}
+
+fn stamp_of(bytes: &[u8]) -> Option<i32> {
+    let at = bytes.windows(4).rposition(|w| w == b"/**/")? + 4;
+    let word = u32::from_le_bytes(bytes.get(at..at + 4)?.try_into().ok()?) ^ 0xFEFE_FDFC;
+    let (check, again) = ((word >> 16) as u16, word as u16);
+    if check != again {
+        return None;
+    }
+    let key = bytes.get(at + 4..at + 16)?;
+    let (start, turn) = ((check >> 8) as usize, (check & 0xFF) as u32);
+    let mut value = 0u32;
+    for i in 0..4 {
+        value |= u32::from(key[(start + i) % 12]) << ((3 - i) * 8);
+    }
+    value = value.rotate_left(turn & 31);
+    let mut mask = 0x1981_0419u32;
+    for _ in 0..4 {
+        value = (value & !0xFF) | ((value ^ mask) & 0xFF);
+        value = value.rotate_right(8);
+        mask = mask.rotate_right(8);
+    }
+    // swap the low and high bytes
+    let (low, high) = (value & 0xFF, value >> 24);
+    value = (value & 0x00FF_FF00) | (low << 24) | high;
+    Some(value as i32)
+}
+
