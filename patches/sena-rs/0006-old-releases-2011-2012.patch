+/// How many values the script pushes (allowing movs between them) right before each call of
+/// the extcall `id`: the argument counts the game's scripts were compiled for.
+fn pushed_arg_counts(script: &[u8], id: u32) -> Vec<usize> {
+    const PUSH: u32 = 0x0001_001F;
+    const MOV: u32 = 0x0001_0001;
+    const EXTCALL: u32 = 0x0001_0017;
+    let words: Vec<u32> = script
+        .chunks_exact(4)
+        .map(|w| u32::from_le_bytes(w.try_into().unwrap()))
+        .collect();
+    let mut out = Vec::new();
+    for i in 0..words.len().saturating_sub(1) {
+        if words[i] != EXTCALL || words[i + 1] != id {
+            continue;
+        }
+        let (mut at, mut count) = (i, 0);
+        loop {
+            if at >= 2 && words[at - 2] == PUSH {
+                count += 1;
+                at -= 2;
+            } else if at >= 3 && words[at - 3] == MOV {
+                at -= 3;
+            } else {
+                break;
+            }
+        }
+        out.push(count);
+    }
+    out
+}
