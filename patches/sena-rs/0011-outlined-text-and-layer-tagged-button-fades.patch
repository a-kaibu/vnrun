+/// Whether the release's Pal.dll draws font effect 3. PalFontDrawText hands each
+/// glyph to a helper that switches on the effect (`cmp reg, N; ja; jmp [reg*4+table]`);
+/// builds whose switch reaches 3 draw an outline for it. `None` when the game ships
+/// no Pal.dll or the helper is not recognized.
+pub fn pal_dll_draws_effect_three(root: &Path) -> Option<bool> {
+    let bytes = [root.join("dll"), root.to_path_buf()].iter().find_map(|dir| {
+        let name = vfs::list_dir(dir).into_iter().find(|name| name.eq_ignore_ascii_case("pal.dll"))?;
+        vfs::read_all(&dir.join(name)).ok()
+    })?;
+    let helper = pe_export_first_call(&bytes, b"PalFontDrawText")?;
+    let code = bytes.get(helper..bytes.len().min(helper + 0x800))?;
+    let mut cases = None;
+    for at in 0..code.len().saturating_sub(12) {
+        let w = &code[at..];
+        if w[0] != 0x83 || !(0xF8..=0xFF).contains(&w[1]) || !(2..=3).contains(&w[2]) {
+            continue;
+        }
+        let jump = match w[3] {
+            0x77 => 5,
+            0x0F if w[4] == 0x87 => 9,
+            _ => continue,
+        };
+        if w[jump] == 0xFF && w[jump + 1] == 0x24 {
+            cases = cases.max(Some(w[2]));
+        }
+    }
+    cases.map(|max| max >= 3)
+}
+
+/// File offset of the target of the first `call rel32` in the named export.
+fn pe_export_first_call(bytes: &[u8], export: &[u8]) -> Option<usize> {
+    let u16_at = |at: usize| Some(u16::from_le_bytes(bytes.get(at..at + 2)?.try_into().ok()?));
+    let u32_at = |at: usize| Some(u32::from_le_bytes(bytes.get(at..at + 4)?.try_into().ok()?));
+    let pe = u32_at(0x3C)? as usize;
+    let sections = u16_at(pe + 6)? as usize;
+    let optional = pe + 24;
+    let table = optional + u16_at(pe + 20)? as usize;
+    let file_offset = |rva: u32| -> Option<usize> {
+        (0..sections).find_map(|index| {
+            let s = table + index * 40;
+            let (size, va, raw) = (u32_at(s + 8)?, u32_at(s + 12)?, u32_at(s + 20)?);
+            (va..va + size.max(u32_at(s + 16)?)).contains(&rva).then(|| (rva - va + raw) as usize)
+        })
+    };
+    let exports = file_offset(u32_at(optional + 96)?)?;
+    let (count, functions, names, ordinals) =
+        (u32_at(exports + 24)?, u32_at(exports + 28)?, u32_at(exports + 32)?, u32_at(exports + 36)?);
+    let (functions, names, ordinals) = (file_offset(functions)?, file_offset(names)?, file_offset(ordinals)?);
+    let index = (0..count as usize).find(|&i| {
+        u32_at(names + i * 4)
+            .and_then(file_offset)
+            .and_then(|at| bytes.get(at..at + export.len() + 1))
+            .is_some_and(|name| &name[..export.len()] == export && name[export.len()] == 0)
+    })?;
+    let ordinal = u16_at(ordinals + index * 2)? as usize;
+    let rva = u32_at(functions + ordinal * 4)?;
+    let start = file_offset(rva)?;
+    let call = (0..0x80).find(|&k| bytes.get(start + k) == Some(&0xE8))?;
+    let target = (rva + call as u32 + 5).wrapping_add(u32_at(start + call + 1)?);
+    file_offset(target)
+}
