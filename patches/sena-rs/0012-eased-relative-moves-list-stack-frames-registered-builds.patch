+        (0, 0) => 1.0 - (t * PI / 2.0).cos(),
+        (0, 1) => (t * PI / 2.0).sin(),
+        (0, _) => -((PI * t).cos() - 1.0) / 2.0,
+        (1..=4, _) => power(family + 1),
+        (5, _) if t <= 0.0 => 0.0,
+        (5, _) if t >= 1.0 => 1.0,
+        (5, 0) => 2f32.powf(10.0 * t - 10.0),
+        (5, 1) => 1.0 - 2f32.powf(-10.0 * t),
+        (5, _) if t < 0.5 => 2f32.powf(20.0 * t - 10.0) / 2.0,
+        (5, _) => (2.0 - 2f32.powf(-20.0 * t + 10.0)) / 2.0,
+        (6, 0) => 1.0 - (1.0 - t * t).max(0.0).sqrt(),
