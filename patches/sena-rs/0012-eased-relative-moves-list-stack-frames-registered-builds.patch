+/// table at 0x4C3BD8): three linear entries, then the usual easing families
+/// (sine, quad, cubic, quart, quint, expo, circ, back, elastic, bounce), each as
+/// in, out and in-out.
+fn ease(index: i32, t: f32) -> f32 {
+    use std::f32::consts::PI;
+    if index < 3 {
+        return t;
+    }
+    let (family, kind) = ((index - 3) / 3, (index - 3) % 3);
+    let power = |n: i32| -> f32 {
+        match kind {
+            0 => t.powi(n),
+            1 => 1.0 - (1.0 - t).powi(n),
+            _ if t < 0.5 => 2f32.powi(n - 1) * t.powi(n),
+            _ => 1.0 - (-2.0 * t + 2.0).powi(n) / 2.0,
+        }
+    };
+    let bounce_out = |x: f32| -> f32 {
+        let (n1, d1) = (7.5625, 2.75);
+        if x < 1.0 / d1 {
+            n1 * x * x
+        } else if x < 2.0 / d1 {
+            let x = x - 1.5 / d1;
+            n1 * x * x + 0.75
+        } else if x < 2.5 / d1 {
+            let x = x - 2.25 / d1;
+            n1 * x * x + 0.9375
+        } else {
+            let x = x - 2.625 / d1;
+            n1 * x * x + 0.984375
+        }
+    };
