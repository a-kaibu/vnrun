+/// Some registered builds (つまもみ 2022) ship a C++-decorated Pal.dll
+/// without PalSystemPathInit; their Game.exe still registers every extcall at start
+/// with `push handler; push 0x00CC00II`.  Hundreds of such pairs mark the
+/// registered dispatch table; static-table builds have none.
+fn game_exe_registers_handlers(root: &Path) -> bool {
+    vfs::list_dir(root).into_iter().any(|name| {
+        let lower = name.to_ascii_lowercase();
+        if !lower.ends_with(".exe") || lower.starts_with("config") {
+            return false;
+        }
+        let Ok(bytes) = vfs::read_all(&root.join(&name)) else { return false };
+        let pairs = bytes
+            .windows(10)
+            .filter(|w| {
+                w[0] == 0x68 && w[4] == 0 && w[5] == 0x68 && w[6] < 0x80 && w[7] == 0
+                    && (1..=0x20).contains(&w[8]) && w[9] == 0
+            })
+            .count();
+        pairs >= 200
     })
 }
 
