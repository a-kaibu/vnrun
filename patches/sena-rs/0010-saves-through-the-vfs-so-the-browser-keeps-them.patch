@@ -0,0 +1,60 @@
+//! Save files through the asset VFS, so the browser build keeps them (the page stores what
+//! `pal_asset::vfs::write_file` hands it) instead of failing on `std::fs`.
+
+use std::io::{Cursor, Error, ErrorKind, Result};
+use std::path::Path;
+use std::time::SystemTime;
+
+use pal_asset::vfs;
+
+pub fn is_file(path: impl AsRef<Path>) -> bool {
+    vfs::is_file(path.as_ref())
+}
+
+pub fn read(path: impl AsRef<Path>) -> Result<Vec<u8>> {
+    vfs::read_all(path.as_ref()).map_err(|e| Error::new(ErrorKind::NotFound, e.to_string()))
+}
+
+pub fn read_to_string(path: impl AsRef<Path>) -> Result<String> {
+    String::from_utf8(read(path)?).map_err(|e| Error::new(ErrorKind::InvalidData, e))
+}
+
+pub fn write(path: impl AsRef<Path>, bytes: impl AsRef<[u8]>) -> Result<()> {
+    vfs::write_file(path.as_ref(), bytes.as_ref())
+}
+
+/// Folders come with [`write`].
+pub fn create_dir_all(_path: impl AsRef<Path>) -> Result<()> {
+    Ok(())
+}
+
+pub fn remove_file(path: impl AsRef<Path>) -> Result<()> {
+    if vfs::remove_file(path.as_ref()) {
+        Ok(())
+    } else {
+        Err(Error::new(ErrorKind::NotFound, "not removed"))
+    }
+}
+
+pub fn copy(from: impl AsRef<Path>, to: impl AsRef<Path>) -> Result<u64> {
+    let bytes = read(from)?;
+    write(to, &bytes)?;
+    Ok(bytes.len() as u64)
+}
+
+/// The whole file, to read and seek in.
+pub fn open(path: impl AsRef<Path>) -> Result<Cursor<Vec<u8>>> {
+    read(path).map(Cursor::new)
+}
+
+pub fn modified(path: impl AsRef<Path>) -> Option<SystemTime> {
+    #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+    {
+        std::fs::metadata(path.as_ref()).ok()?.modified().ok()
+    }
+    #[cfg(all(target_arch = "wasm32", target_os = "unknown"))]
+    {
+        let _ = path;
+        None
+    }
+}
