 static tTVPAtInstallClass vnrun_install_move_file(TJS_W("vnrunMoveFile"), vnrun_create_move_file, TJS_W(""));
 static tTVPAtInstallClass vnrun_install_delete_file(TJS_W("vnrunDeleteFile"), vnrun_create_delete_file, TJS_W(""));
