+
+#ifdef __EMSCRIPTEN__
+// Pointer input from the page, in window pixels. button: 0 = move only, else SDL_BUTTON_*.
+extern "C" EMSCRIPTEN_KEEPALIVE void vnrun_mouse(int x, int y, int button, int down)
+{
+	SDL_Event event;
+	SDL_zero(event);
+	if (button == 0)
+	{
+		event.type = SDL_MOUSEMOTION;
+		event.motion.windowID = vnrun_window_id;
+		event.motion.x = x;
+		event.motion.y = y;
+	}
+	else
+	{
+		event.type = down ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+		event.button.windowID = vnrun_window_id;
+		event.button.button = button;
+		event.button.state = down ? SDL_PRESSED : SDL_RELEASED;
+		event.button.clicks = 1;
+		event.button.x = x;
+		event.button.y = y;
+	}
+	SDL_PushEvent(&event);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void vnrun_wheel(int dy)
+{
+	SDL_Event event;
+	SDL_zero(event);
+	event.type = SDL_MOUSEWHEEL;
+	event.wheel.windowID = vnrun_window_id;
+	event.wheel.y = dy;
+	SDL_PushEvent(&event);
+}
+#endif
