+/// The vertical twin of [`native_horizontal_blur`] (BGI 1.7x sub_414D60).
+pub(super) fn native_vertical_blur(source: &DecodedImage, alpha: i32, clamp: bool) -> DecodedImage {
+    let transpose = |image: &DecodedImage| {
+        let (w, h) = (image.width as usize, image.height as usize);
+        let mut out = image.clone();
+        out.width = image.height;
+        out.height = image.width;
+        for y in 0..h {
+            for x in 0..w {
+                let from = (y * w + x) * 4;
+                let to = (x * h + y) * 4;
+                out.rgba[to..to + 4].copy_from_slice(&image.rgba[from..from + 4]);
+            }
+        }
+        out
+    };
+    transpose(&native_horizontal_blur(&transpose(source), alpha, clamp))
+}
