+/// Builds without GetGameId (Hello,good-bye) check the marker by name:
+/// FileExists("HelloGoodBye") followed by a jump straight to TerminateInterpreter.
+fn install_markers(manager: &ResourceManager) -> Vec<String> {
+    let Ok(bytes) = manager.read_decoded_from_archive("system.arc", "ipl._bp") else {
+        return Vec::new();
+    };
+    let program = ethornell_script::parse_bp_program(None, &bytes);
+    let terminates = |target: u32| {
+        program
+            .instructions
+            .iter()
+            .find(|instruction| instruction.offset == u64::from(target))
+            .is_some_and(|instruction| instruction.known_call == Some("TerminateInterpreter"))
+    };
+    program
+        .instructions
+        .windows(4)
+        .filter_map(|w| match (w[0].operands.as_ref(), w[2].operands.as_ref()) {
+            ([ethornell_script::BpOperand::String(name)], [ethornell_script::BpOperand::Offset(target)])
+                if w[1].known_call == Some("FileExists")
+                    && w[3].opcode.name() == "jc"
+                    && terminates(*target) =>
+            {
+                Some(name.clone())
+            }
+            _ => None,
+        })
+        .collect()
+}
