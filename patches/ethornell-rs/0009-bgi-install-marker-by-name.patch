+/// Builds without GetGameId (Hello,good-bye) check the marker by name:
+/// FileExists("HelloGoodBye") followed by a jump straight to TerminateInterpreter.
+/// 1.7x builds (顔のない月) pick the name from two strings first and jump inline.
+fn install_markers(manager: &ResourceManager) -> Vec<String> {
+    use ethornell_script::BpOperand;
+    let Ok(bytes) = manager.read_decoded_from_archive("system.arc", "ipl._bp") else {
+        return Vec::new();
+    };
+    let program = ethornell_script::parse_bp_program(None, &bytes);
+    let code = &program.instructions;
+    let terminates = |target: u32| {
+        code.iter()
+            .find(|instruction| instruction.offset == u64::from(target))
+            .is_some_and(|instruction| instruction.known_call == Some("TerminateInterpreter"))
+    };
+    let target = |instruction: &ethornell_script::BpInstruction| {
+        instruction.operands.iter().find_map(|operand| match operand {
+            BpOperand::Offset(target) => Some(*target),
+            _ => None,
+        })
+    };
+    let mut markers = Vec::new();
+    for (i, instruction) in code.iter().enumerate() {
+        if instruction.known_call != Some("FileExists") {
+            continue;
+        }
+        let jump = match code.get(i + 1..i + 3) {
+            Some([a, _]) if a.opcode.name() == "jc" => target(a),
+            Some([a, b]) if b.opcode.name() == "jc" => target(a),
+            _ => None,
+        };
+        if !jump.is_some_and(terminates) {
+            continue;
+        }
+        // the strings pushed since the previous call or jump
+        let since = code[..i]
+            .iter()
+            .rposition(|b| b.known_call.is_some() || b.opcode.name() == "jc")
+            .map_or(0, |k| k + 1);
+        for before in &code[since.max(i.saturating_sub(6))..i] {
+            for operand in before.operands.iter() {
+                if let BpOperand::String(name) = operand {
+                    markers.push(name.clone());
+                }
+            }
+        }
+    }
+    markers
+}
