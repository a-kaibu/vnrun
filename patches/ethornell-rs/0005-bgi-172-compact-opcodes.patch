+fn compact_arith(kind: i32, a: i32, b: i32) -> i32 {
+    match kind {
+        0 => a.wrapping_add(b),
+        1 => a.wrapping_sub(b),
+        2 => a.wrapping_mul(b),
+        3 if b != 0 => a.wrapping_div(b),
+        4 if b != 0 => a.wrapping_rem(b),
+        5 => a & b,
+        6 => a | b,
+        7 => a ^ b,
+        8 => a.wrapping_shl(b as u32),
+        9 => (a as u32).wrapping_shr(b as u32) as i32,
+        10 => a.wrapping_shr(b as u32),
+        _ => i32::MIN,
+    }
