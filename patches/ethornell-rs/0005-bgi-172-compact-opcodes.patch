+    fn execute_bgi172_call(&mut self, group: u8, id: u8) -> VmResult<()> {
+        match (group, id) {
+            // Sys81:21 converts CP932 text to UTF-8 (MultiByteToWideChar 932).
+            // ethornell keeps text in CP932, so the conversion is a copy, and
+            // Sys81:27 reports that no conversion is needed.
