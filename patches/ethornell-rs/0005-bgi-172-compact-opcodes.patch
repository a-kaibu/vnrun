+/// Opcodes added by BGI 1.677 (script compatibility 1.72): fused loads,
+/// stores, arithmetic and branches.
+pub fn is_compact_opcode(code: u8) -> bool {
+    matches!(
+        code,
+        0x03 | 0x0d | 0x0e | 0x0f | 0x12 | 0x13 | 0x18..=0x1f | 0x2c..=0x2f | 0x36 | 0x37
+            | 0x3b | 0x3c | 0x3e | 0x3f | 0x45 | 0x46 | 0x47 | 0x55 | 0x73 | 0xe2..=0xea
+            | 0xec..=0xf2 | 0xf4 | 0xf5 | 0xf7..=0xfb
+    )
+}
+
+/// Reads a compact opcode's operands. Numbers become `I32`; a width-tagged
+/// literal becomes `U8(width)` then `I32(value)`; a relative target becomes
+/// the absolute `Offset` it names.
+struct CompactOperands<'a, 'b> {
+    cursor: &'a mut Cursor<&'b [u8]>,
+    raw_len: &'a mut usize,
+    warning: &'a mut Option<String>,
+    operands: &'a mut Vec<BpOperand>,
+    offset: u64,
+}
+
+impl CompactOperands<'_, '_> {
+    fn byte(&mut self) -> u8 {
+        read_u8_operand(self.cursor, self.raw_len, self.warning).unwrap_or_default()
+    }
+    fn u8(&mut self) {
+        let value = self.byte();
+        self.operands.push(BpOperand::U8(value));
+    }
+    fn i8(&mut self) {
+        let value = self.byte() as i8;
+        self.operands.push(BpOperand::I32(value.into()));
+    }
+    fn u16(&mut self) {
+        let value = read_u16_operand(self.cursor, self.raw_len, self.warning).unwrap_or_default();
+        self.operands.push(BpOperand::I32(value.into()));
+    }
+    fn i16(&mut self) {
+        let value = read_u16_operand(self.cursor, self.raw_len, self.warning).unwrap_or_default();
+        self.operands.push(BpOperand::I32((value as i16).into()));
+    }
+    fn u32(&mut self) {
+        let value = read_u32_operand(self.cursor, self.raw_len, self.warning).unwrap_or_default();
+        self.operands.push(BpOperand::I32(value as i32));
+    }
+    fn target(&mut self) {
+        let rel = read_u16_operand(self.cursor, self.raw_len, self.warning).unwrap_or_default();
+        self.operands.push(BpOperand::Offset((self.offset as i64 + rel as i16 as i64) as u32));
+    }
+    fn sleb_value(&mut self) -> i32 {
+        let (mut value, mut shift) = (0u32, 0u32);
+        loop {
+            let byte = self.byte();
+            if shift < 32 {
+                value |= u32::from(byte & 0x7f) << shift;
+            }
+            shift += 7;
+            if byte & 0x80 == 0 {
+                if byte & 0x40 != 0 && shift < 32 {
+                    value |= u32::MAX << shift;
+                }
+                return value as i32;
+            }
+            if self.warning.is_some() {
+                return value as i32;
+            }
+        }
+    }
+    fn sleb(&mut self) {
+        let value = self.sleb_value();
+        self.operands.push(BpOperand::I32(value));
+    }
+    /// A literal whose low two bits are a store width (target sub_88050).
+    fn typed(&mut self) {
+        let value = self.sleb_value();
+        self.operands.push(BpOperand::U8((value & 3) as u8));
+        self.operands.push(BpOperand::I32(value >> 2));
+    }
+
+    fn read(&mut self, code: u8) {
+        match code {
+            0x03 => {
+                let head = self.byte();
+                if head & 0x80 == 0 {
+                    for _ in 0..=head {
+                        self.sleb();
+                    }
+                } else {
+                    let value = match head & 3 {
+                        0 => self.byte() as i8 as i32,
+                        1 => read_u16_operand(self.cursor, self.raw_len, self.warning)
+                            .unwrap_or_default() as i16 as i32,
+                        2 => read_u32_operand(self.cursor, self.raw_len, self.warning)
+                            .unwrap_or_default() as i32,
+                        _ => {
+                            let low = read_u32_operand(self.cursor, self.raw_len, self.warning)
+                                .unwrap_or_default();
+                            let _ = read_u32_operand(self.cursor, self.raw_len, self.warning);
+                            low as i32
+                        }
+                    };
+                    self.operands.push(BpOperand::I32(value));
+                }
+            }
+            0x0d | 0x1f => self.typed(),
+            0x0e | 0xe4..=0xe7 => {
+                self.u16();
+                self.typed();
+            }
+            0x0f | 0x19 | 0x1d | 0x1e | 0xe8 => self.u16(),
+            0x12 | 0x2c..=0x2f | 0xec => self.sleb(),
+            0x13 | 0xee => self.target(),
+            0x18 | 0xef => self.u32(),
+            0x1a | 0x1b => {
+                self.u16();
+                self.sleb();
+            }
+            0x1c => {
+                self.u16();
+                self.i8();
+            }
+            0x36 | 0x3f => {
+                self.u8();
+                self.sleb();
+            }
+            0x37 => {
+                self.u8();
+                self.target();
+                self.sleb();
+            }
+            0x3b => {
+                self.u8();
+                self.target();
+            }
+            0x3c => self.i8(),
+            0x3e => self.u8(),
+            0xe2 | 0xe3 => {
+                let count = self.byte();
+                for _ in 0..=count {
+                    self.u16();
+                }
+            }
+            0xe9 => {
+                self.u16();
+                self.u16();
+            }
+            0xea | 0xf1 => {
+                self.u16();
+                self.u16();
+                self.sleb();
+            }
+            0xed => {
+                self.u16();
+                self.sleb();
+            }
+            0xf0 => {
+                self.u32();
+                self.u16();
+                self.sleb();
+            }
+            0xf2 => {
+                self.u16();
+                self.u16();
+                self.u16();
+                self.sleb();
+            }
+            0xf4 => {
+                self.u16();
+                self.u32();
+                self.u16();
+                self.i16();
+            }
+            0xf5 => {
+                self.u16();
+                self.u16();
+                self.i16();
+                self.u16();
+                self.i16();
+            }
+            0xf7 | 0xfb => {
+                self.u16();
+                self.u16();
+                self.i16();
+            }
+            0xf8 | 0xfa => {
+                self.u32();
+                self.u16();
+                self.i16();
+            }
+            0xf9 => {
+                self.u16();
+                self.i16();
+                self.u16();
+                self.i16();
+            }
+            _ => {}
+        }
+    }
+}
