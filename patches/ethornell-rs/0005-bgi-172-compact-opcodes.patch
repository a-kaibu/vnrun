+/// Comparison selector of the 1.7x branch and compare opcodes (sub_CF9D0).
+fn compact_compare(kind: i32, a: i32, b: i32) -> i32 {
+    match kind {
+        0 => (a == b) as i32,
+        1 => (a != b) as i32,
+        2 => (a < b) as i32,
+        3 => (a <= b) as i32,
+        4 => (a >= b) as i32,
+        5 => (a > b) as i32,
+        6 => a & b,
+        7 => a | b,
+        8 => (a != 0 && b != 0) as i32,
+        9 => (a != 0 || b != 0) as i32,
+        _ => 0,
+    }
