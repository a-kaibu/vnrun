--- a/crates/ethornell-vm/src/lib.rs
+++ b/crates/ethornell-vm/src/lib.rs
@@ -75,7 +75,23 @@ const CODE_WINDOW_SIZE: u32 = HEAP_OFFSET_BASE - CODE_WINDOW_OFFSET;
 const HEAP_OFFSET_BASE: u32 = 0x0020_0000;
 const HEAP_MEMORY_BASE: usize = (LOCAL_MEMORY_BASE + HEAP_OFFSET_BASE) as usize;
 const INITIAL_MEMORY_SIZE: usize = 16 * 1024 * 1024;
-const MAX_MEMORY_SIZE: usize = 256 * 1024 * 1024;
+// The target allocates from the process heap; BGI 1.7x save/load screens
+// hold three 63 MB record buffers and a 32 MB one at once, which does not
+// fit the 32 MB-segment layout below 256 MB.
+const MAX_MEMORY_SIZE: usize = 512 * 1024 * 1024;
+
+/// Backing size for a write ending at `end`: powers of two up to 256 MB,
+/// then whole 32 MB steps so a large heap does not double the buffer.
+fn grown_memory_size(end: usize) -> usize {
+    const STEP_LIMIT: usize = 256 * 1024 * 1024;
+    let size = end.next_power_of_two().max(INITIAL_MEMORY_SIZE);
+    let size = if size > STEP_LIMIT {
+        end.div_ceil(AUX_MEMORY_SEGMENT_SIZE as usize) * AUX_MEMORY_SEGMENT_SIZE as usize
+    } else {
+        size
+    };
+    size.min(MAX_MEMORY_SIZE)
+}
 const OPERAND_STACK_CAPACITY: usize = 4096;
 
