// vnrun: KiriKiri SDL2 cannot load Windows plugins (Plugins.link does nothing). For the
// plugins games use most, Plugins.link runs a script that stands in for the plugin instead.
global.vnrunPlugins = %[
	root: global.KirikiriPolyfillRoot + "plugins/",
	link: global.Plugins.link,
	loaded: %[],
	standIns: %[
		"csvparser.dll" => "csvParser.tjs",
		"fstat.dll" => "fstat.tjs",
		"windowex.dll" => "windowEx.tjs",
		"layerexdraw.dll" => "layerExDraw.tjs",
		"scriptsex.dll" => "scriptsEx.tjs",
		"kagparserex.dll" => "KAGParserEx.tjs",
		"addfont.dll" => "addFont.tjs",
		"win32dialog.dll" => "win32dialog.tjs",
		"sigcheck.dll" => "sigcheck.tjs",
		"getsample.dll" => "getSample.tjs",
	],
];
global.Plugins.link = function(name) {
	var p = global.vnrunPlugins;
	var key = Storages.extractStorageName(name).toLowerCase();
	var script = p.standIns[key];
	if (script === void) return p.link(name);
	if (p.loaded[key]) return;
	p.loaded[key] = true;
	Debug.message("(vnrun) " + name + ": " + script);
	Scripts.execStorage(p.root + script);
} incontextof global;
// The stand-ins count as loaded plugins (scripts look for their names in Plugins.getList).
global.vnrunPlugins.getList = global.Plugins.getList;
global.Plugins.getList = function() {
	var p = global.vnrunPlugins;
	var list = p.getList === void ? [] : p.getList();
	var names = [];
	names.assign(p.loaded);
	for (var i = 0; i < names.count; i += 2) list.add(names[i]);
	return list;
} incontextof global;
// addFont also comes as a TPM, which KiriKiri loads by itself before startup.tjs.
Scripts.execStorage(global.vnrunPlugins.root + "addFont.tjs");
