// vnrun: fstat.dll. The browser build has no file system calls for scripts, so these only
// answer from what Storages already knows; changes to files are not made.
{
	var S = global.Storages;
	if (typeof(S.fstat) === "undefined")
		S.fstat = function(name) {
			if (!Storages.isExistentStorage(name)) return void;
			return %[ size: 0, mtime: new Date(), atime: new Date(), ctime: new Date() ];
		};
	if (typeof(S.isExistentDirectory) === "undefined")
		S.isExistentDirectory = function(name) { return true; };
	if (typeof(S.createDirectory) === "undefined")
		S.createDirectory = function(name) { return true; };
	if (typeof(S.removeDirectory) === "undefined")
		S.removeDirectory = function(name) { return false; };
	if (typeof(S.deleteFile) === "undefined")
		S.deleteFile = function(name) { return false; };
	if (typeof(S.moveFile) === "undefined")
		S.moveFile = function(from, to) { return false; };
	if (typeof(S.dirlist) === "undefined")
		S.dirlist = function(name) { return []; };
	if (typeof(S.dirlistEx) === "undefined")
		S.dirlistEx = function(name) { return []; };
	if (typeof(S.exportFile) === "undefined")
		S.exportFile = function(from, to) { return false; };
	if (typeof(S.getTime) === "undefined")
		S.getTime = function(name) { return %[ mtime: new Date(), atime: new Date(), ctime: new Date() ]; };
	if (typeof(S.setTime) === "undefined")
		S.setTime = function(name, time) { return false; };
	if (typeof(S.selectDirectory) === "undefined")
		S.selectDirectory = function(params) { return false; };
	if (typeof(S.getDisplayName) === "undefined")
		S.getDisplayName = function(name) { return Storages.extractStorageName(name); };
}
