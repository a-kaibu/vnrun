// vnrun: csvParser.dll. new CSVParser(target, separator=","), then init(text) or
// initStorage(name) and getNextLine() until void, or parse(text) / parseStorage(name), which
// call target.doLine(fields, lineNumber) (no target: this.doLine). Quoted fields may hold
// separators, "" and newlines. Spaces and tabs around unquoted fields are dropped (UI .func files
// line their columns up with tabs). Empty lines are skipped.
class CSVParser
{
	var target, separator;
	var text = "", pos = 0;
	var currentLineNumber = 0;

	function CSVParser(target = void, separator = ",") {
		this.target = target;
		// games often pass the separator's character code (44, 9)
		this.separator = typeof(separator) == "Integer" ? $separator : separator;
	}
	function finalize() {}

	function init(text) {
		this.text = text === void ? "" : (string)text;
		pos = 0;
		currentLineNumber = 0;
	}
	function initStorage(name, utf8 = false) {
		var lines = [];
		lines.load(name);
		init(lines.join("\n"));
	}

	function getNextLine() {
		var len = text.length;
		while (pos < len) {
			var fields = [], field = "", quoted = false, wasQuoted = false, any = false;
			currentLineNumber++;
			while (pos < len) {
				var c = text[pos];
				if (quoted) {
					if (c == "\"") {
						if (pos + 1 < len && text[pos + 1] == "\"") { field += "\""; pos += 2; continue; }
						quoted = false; pos++; continue;
					}
					if (c == "\n") currentLineNumber++;
					field += c; pos++; continue;
				}
				if (c == "\"") { if (!wasQuoted) field = trim(field); quoted = wasQuoted = true; any = true; pos++; continue; }
				if (c == separator) { fields.add(wasQuoted ? field : trim(field)); field = ""; wasQuoted = false; any = true; pos++; continue; }
				if (c == "\r") { pos++; continue; }
				if (c == "\n") { pos++; break; }
				field += c; any = true; pos++;
			}
			if (!any) continue;
			fields.add(wasQuoted ? field : trim(field));
			return fields;
		}
		return void;
	}

	function trim(s) {
		var a = 0, b = s.length;
		while (a < b && (s[a] == " " || s[a] == "\t")) a++;
		while (b > a && (s[b - 1] == " " || s[b - 1] == "\t")) b--;
		return s.substring(a, b - a);
	}

	function parse(text = void) {
		if (text !== void) init(text);
		// no target (void or null): a subclass's own doLine
		var to = target === void || target === null ? this : target;
		if (typeof(to.doLine) === "undefined") return;
		var fields;
		while ((fields = getNextLine()) !== void)
			to.doLine(fields, currentLineNumber);
	}
	function parseStorage(name, utf8 = false) {
		initStorage(name, utf8);
		parse();
	}
}
