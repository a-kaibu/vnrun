// vnrun: members that games use from plugins or Windows builds, where nothing stands in for
// the whole plugin. Each only fills in what is missing.

// Files the engine doesn't have, but games expect next to the exe (compat/k2compat.tjs).
Storages.addAutoPath(global.KirikiriPolyfillRoot + "compat/");

// Storages.isExistentDirectory and friends (fstat.dll), used by some games without linking it.
Scripts.execStorage(global.KirikiriPolyfillRoot + "plugins/fstat.tjs");

// Steam builds draw through DrawDeviceForSteam (the overlay); the plain draw device does.
if (typeof(global.DrawDeviceForSteam) === "undefined" && typeof(global.Window.BasicDrawDevice) !== "undefined")
	global.DrawDeviceForSteam = global.Window.BasicDrawDevice;

// Mojimo (Morisawa) game fonts come out of a plugin; the player's font stands in for them.
if (typeof(global.ExtractMojimoGameFont) === "undefined")
	global.ExtractMojimoGameFont = function() { return false; };

// Games written for KiriKiri 2 build some menus only there (@if (!kirikiriz)) and use them
// anyway, e.g. lass_pixy's dispDoubleBufferMenu: windows have a menu nobody sees for them.
{
	// under a parent of their own, as scripts move them elsewhere (menu.parent.remove(menu))
	var hidden = new MenuItem(null, "");
	hidden.visible = false;
	var names = [ "dispDoubleBufferMenu", "useDoubleBufferMenuItem" ];
	for (var i = 0; i < names.count; i++)
		if (typeof(global.Window[names[i]]) === "undefined") {
			var item = new MenuItem(null, "");
			hidden.add(item);
			global.Window[names[i]] = item;
		}
}

// Window.setLayerPos is built only with USE_OBSOLETE_FUNCTIONS; KAG 2 era quakes (stopQuake)
// still call it. It would move the layers inside the window, which the SDL form ignores anyway
// (layerLeft/layerTop are obsolete too), so the quake doesn't shake and nothing fails.
if (typeof(global.Window.setLayerPos) === "undefined")
	global.Window.setLayerPos = function(l, t) {} incontextof null;

// Window.getNormalRect (newer Windows builds): the window's rect when not maximized. There is
// only one state here, the current one.
if (typeof(global.Window.getNormalRect) === "undefined")
	global.Window.getNormalRect = function() {
		return %[ x: left, y: top, w: width, h: height, left: left, top: top, width: width, height: height ];
	} incontextof null;

// Gamepad plugins export XInput's button bits as gp* globals; games map them even when no pad
// is ever read (excelchiffon's padButtonKeyMap).
if (typeof(global.gpButtonA) === "undefined") {
	global.gpButtonA = 0x1000; global.gpButtonB = 0x2000; global.gpButtonX = 0x4000; global.gpButtonY = 0x8000;
	global.gpButtonBack = 0x20; global.gpButtonStart = 0x10;
	global.gpButtonLeftShoulder = 0x100; global.gpButtonRightShoulder = 0x200;
	global.gpButtonLeftThumb = 0x40; global.gpButtonRightThumb = 0x80;
	global.gpTimer = 0; global.gpTouchDown = 30; // XINPUT_GAMEPAD_TRIGGER_THRESHOLD
}

// Windows builds give menu items the title bar's bitmaps (HBMMENU_*) for window control menus.
if (typeof(global.MenuItem.biMinimize) === "undefined") {
	var M = global.MenuItem;
	M.biSystem = 1; M.biRestore = 2; M.biMinimize = 3; M.biMaximize = 10; M.biClose = 5;
	M.biPopupClose = 8; M.biPopupRestore = 9; M.biPopupMaximize = 10; M.biPopupMinimize = 11;
}

// The window handle, which games hand to plugins (gamepad.dll); there is none here.
if (typeof(global.Window.HWND) === "undefined")
	global.Window.HWND = 0;

// Window.registerHotKey (Windows builds and plugins): system-wide keys such as PrtSc for
// screenshot plugins. The page has none to register; it says yes and the key never fires.
if (typeof(global.Window.registerHotKey) === "undefined") {
	global.Window.registerHotKey = function() { return true; } incontextof null;
	global.Window.unregisterHotKey = function() { return true; } incontextof null;
}

// Scripts.loadDataPack (newer KiriKiri Z): the value in a "TJS/ns0" data pack, read natively.
if (typeof(global.Scripts.loadDataPack) === "undefined" && typeof(global.vnrunLoadDataPack) !== "undefined")
	global.Scripts.loadDataPack = global.vnrunLoadDataPack;
