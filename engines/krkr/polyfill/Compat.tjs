// vnrun: members that games use from plugins or Windows builds, where nothing stands in for
// the whole plugin. Each only fills in what is missing.

// Files the engine doesn't have, but games expect next to the exe (compat/k2compat.tjs).
Storages.addAutoPath(global.KirikiriPolyfillRoot + "compat/");

// Storages.isExistentDirectory and friends (fstat.dll), used by some games without linking it.
Scripts.execStorage(global.KirikiriPolyfillRoot + "plugins/fstat.tjs");

// Steam builds draw through DrawDeviceForSteam (the overlay); the plain draw device does.
if (typeof(global.DrawDeviceForSteam) === "undefined" && typeof(global.Window.BasicDrawDevice) !== "undefined")
	global.DrawDeviceForSteam = global.Window.BasicDrawDevice;

// KiriKiri 2's Windows draw device: menus show which drawer it uses (kai 2012's Override.tjs).
// The page draws everything: the draw device's drawer is dtNone (patches/krkrsdl2 0010).
if (typeof(global.Window.PassThroughDrawDevice) === "undefined")
	global.Window.PassThroughDrawDevice = %[ dtNone: 0, dtDrawDib: 1, dtDBGDI: 2, dtDBDD: 3, dtDBD3D: 4 ];
// A mouse hook from a Windows plugin (lass_pixy): the page sends every mouse event anyway.
if (typeof(global.Window.startMouseHook) === "undefined") {
	global.Window.startMouseHook = function() {} incontextof null;
	global.Window.stopMouseHook = function() {} incontextof null;
}

// Mojimo (Morisawa) game fonts come out of a plugin; the player's font stands in for them.
if (typeof(global.ExtractMojimoGameFont) === "undefined")
	global.ExtractMojimoGameFont = function() { return false; };

// The extrans.dll stand-in's Layer.beginTransition, off until a game links the plugin.
global.vnrunExtransInstall = true;
Scripts.execStorage(global.KirikiriPolyfillRoot + "plugins/extrans.tjs");
global.vnrunExtransInstall = false;

// layerExImage (Layer.light and colour filters): games load it as plugin/layerExImage.tpm.
Scripts.execStorage(global.KirikiriPolyfillRoot + "plugins/layerExImage.tjs");

// layerExBTOA (Layer.clipAlphaRect, shrinkCopy), also part of PackinOne.dll.
Scripts.execStorage(global.KirikiriPolyfillRoot + "plugins/layerExBTOA.tjs");

// KiriKiri 2's Layer.pileRect and blendRect, which KiriKiri Z dropped for operateRect (its
// k2compat.tjs puts them back the same way). Defined here, before KAGLayer and the games' own
// Layer classes, so that they inherit them.
if (typeof(global.Layer.pileRect) === "undefined") {
	// pileRect: src over this layer by src's alpha, this layer's alpha kept.
	global.Layer.pileRect = function(dleft, dtop, src, sleft, stop, swidth, sheight, opa = 255) {
		operateRect(dleft, dtop, src, sleft, stop, swidth, sheight, omAlpha, opa);
	} incontextof null;
}
if (typeof(global.Layer.blendRect) === "undefined") {
	// blendRect: src over this layer at a constant opacity, src's alpha ignored.
	global.Layer.blendRect = function(dleft, dtop, src, sleft, stop, swidth, sheight, opa = 255) {
		operateRect(dleft, dtop, src, sleft, stop, swidth, sheight, omOpaque, opa);
	} incontextof null;
}

// KiriKiri's text input box (KAG's [input], name entry): the browser's prompt() stands in for it.
// Like the original, it gives void when cancelled. vnrunPrompt is in patches/krkrsdl2 0017.
if (typeof(global.System.inputString) === "undefined" && typeof(global.vnrunPrompt) !== "undefined")
	global.System.inputString = function(caption, prompt, initial) {
		var text = prompt != "" ? prompt : caption;
		return global.vnrunPrompt(text, initial === void ? "" : string(initial));
	} incontextof null;

// Games written for KiriKiri 2 build some menus only there (@if (!kirikiriz)) and use them
// anyway, e.g. lass_pixy's dispDoubleBufferMenu: windows have a menu nobody sees for them.
{
	// under a parent of their own, as scripts move them elsewhere (menu.parent.remove(menu))
	var hidden = new MenuItem(null, "");
	hidden.visible = false;
	var names = [ "dispDoubleBufferMenu", "useDoubleBufferMenuItem" ];
	for (var i = 0; i < names.count; i++)
		if (typeof(global.Window[names[i]]) === "undefined") {
			var item = new MenuItem(null, "");
			hidden.add(item);
			global.Window[names[i]] = item;
		}
}

// Window.setLayerPos is built only with USE_OBSOLETE_FUNCTIONS; KAG 2 era quakes (stopQuake)
// still call it. It would move the layers inside the window, which the SDL form ignores anyway
// (layerLeft/layerTop are obsolete too), so the quake doesn't shake and nothing fails.
if (typeof(global.Window.setLayerPos) === "undefined")
	global.Window.setLayerPos = function(l, t) {} incontextof null;

// Window.getNormalRect (newer Windows builds): the window's rect when not maximized. There is
// only one state here, the current one.
if (typeof(global.Window.getNormalRect) === "undefined")
	global.Window.getNormalRect = function() {
		return %[ x: left, y: top, w: width, h: height, left: left, top: top, width: width, height: height ];
	} incontextof null;

// Gamepad plugins export XInput's button bits as gp* globals; games map them even when no pad
// is ever read (excelchiffon's padButtonKeyMap).
if (typeof(global.gpButtonA) === "undefined") {
	global.gpButtonA = 0x1000; global.gpButtonB = 0x2000; global.gpButtonX = 0x4000; global.gpButtonY = 0x8000;
	global.gpButtonBack = 0x20; global.gpButtonStart = 0x10;
	global.gpButtonLeftShoulder = 0x100; global.gpButtonRightShoulder = 0x200;
	global.gpButtonLeftThumb = 0x40; global.gpButtonRightThumb = 0x80;
	global.gpTimer = 0; global.gpTouchDown = 30; // XINPUT_GAMEPAD_TRIGGER_THRESHOLD
}

// Windows builds give menu items the title bar's bitmaps (HBMMENU_*) for window control menus.
if (typeof(global.MenuItem.biMinimize) === "undefined") {
	var M = global.MenuItem;
	M.biSystem = 1; M.biRestore = 2; M.biMinimize = 3; M.biMaximize = 10; M.biClose = 5;
	M.biPopupClose = 8; M.biPopupRestore = 9; M.biPopupMaximize = 10; M.biPopupMinimize = 11;
}

// The window handle, which games hand to plugins (gamepad.dll); there is none here.
if (typeof(global.Window.HWND) === "undefined")
	global.Window.HWND = 0;

// Window.registerHotKey (Windows builds and plugins): system-wide keys such as PrtSc for
// screenshot plugins. The page has none to register; it says yes and the key never fires.
if (typeof(global.Window.registerHotKey) === "undefined") {
	global.Window.registerHotKey = function() { return true; } incontextof null;
	global.Window.unregisterHotKey = function() { return true; } incontextof null;
}

// proxyfs.dll's proxy:// storages (plugins/proxyFs.tjs) hold nothing here. Asking for one would
// throw "Not supported media type", so it does not exist.
global.vnrunIsExistentStorage = global.Storages.isExistentStorage;
global.Storages.isExistentStorage = function(name) {
	if (name.toLowerCase().indexOf("proxy://") == 0) return false;
	return global.vnrunIsExistentStorage(name);
} incontextof global;
// Scripts.loadDataPack (newer KiriKiri Z): the value in a "TJS/ns0" data pack, read natively.
// A pack inside a PNG (kakenuke's mojimo-game.png, licensed fonts for the game's own use) is not
// read: it gives nothing, and the text falls back to the page's font.
if (typeof(global.Scripts.loadDataPack) === "undefined" && typeof(global.vnrunLoadDataPack) !== "undefined")
	global.Scripts.loadDataPack = function(storage, *) {
		if (Storages.extractStorageExt(storage).toLowerCase() == ".png") {
			Debug.message("(vnrun) loadDataPack: skipped " + storage);
			return %[];
		}
		return global.vnrunLoadDataPack(storage, *);
	} incontextof global;

// No video decoding: a VideoOverlay movie ends as soon as it plays, so scripts waiting for its
// "stop" go on (with_ribbon 2011's opening movie left the screen white).
global.vnrunVideo = %[ play: global.VideoOverlay.play, ended: [], trigger: void ];
global.vnrunVideo.trigger = new AsyncTrigger(function() {
	var v = global.vnrunVideo, list = [];
	list.assign(v.ended);
	v.ended.clear();
	for (var i = 0; i < list.count; i++)
		if (isvalid list[i] && typeof(list[i].onStatusChanged) !== "undefined") list[i].onStatusChanged("stop");
} incontextof global, "");
global.vnrunVideo.trigger.cached = false;
global.VideoOverlay.play = function() {
	(global.vnrunVideo.play incontextof this)();
	global.vnrunVideo.ended.add(this);
	global.vnrunVideo.trigger.trigger();
} incontextof null;

// A few releases keep their author's build-machine drive paths as optional
// search folders. They cannot exist in the browser; Windows simply found no files.
var vnrunAddAutoPath = Storages.addAutoPath;
Storages.addAutoPath = function(path) {
    if(path.length >= 3 && path[1] == ":" && (path[2] == "/" || path[2] == "\\")) return;
    return global.vnrunAddAutoPath(path);
};

// Some Windows engines expose Motion as a built-in rather than linking a DLL.
Scripts.execStorage(global.KirikiriPolyfillRoot + "plugins/motionPlayer.tjs");

// The page calls this (vnrun_save_state) when the tab is hidden or the player leaves. KAG keeps
// system variables (read text, settings, unlocked CG) until the game quits normally, which a
// closed tab never does; a game that saved them half-way through its first-start setup then
// failed on every later start (madosoft 2013: sf.voiceVisible missing).
global.vnrunSaveState = function() {
	// KAG's window is global.kag. Games with their own system (parasol's MainWindow) keep the same
	// on their main window under another name, and also write it only when the window closes.
	var w = void;
	if (typeof(global.kag) !== "undefined" && isvalid global.kag) w = global.kag;
	else if (Window.mainWindow !== null && isvalid Window.mainWindow) w = Window.mainWindow;
	if (w === void) return;
	var names = [ "saveSystemVariables", "SystemSave" ];
	for (var i = 0; i < names.count; i++) {
		if (typeof(w[names[i]]) !== "Object") continue;
		try {
			w[names[i]]();
		} catch (e) {
			Debug.message("(vnrun) " + names[i] + ": " + e.message);
		}
		break;
	}
} incontextof global;
