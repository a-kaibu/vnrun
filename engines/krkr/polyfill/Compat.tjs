// vnrun: members that games use from plugins or Windows builds, where nothing stands in for
// the whole plugin. Each only fills in what is missing.

// Files the engine doesn't have, but games expect next to the exe (compat/k2compat.tjs).
Storages.addAutoPath(global.KirikiriPolyfillRoot + "compat/");

// Storages.isExistentDirectory and friends (fstat.dll), used by some games without linking it.
Scripts.execStorage(global.KirikiriPolyfillRoot + "plugins/fstat.tjs");

// Steam builds draw through DrawDeviceForSteam (the overlay); the plain draw device does.
if (typeof(global.DrawDeviceForSteam) === "undefined" && typeof(global.Window.BasicDrawDevice) !== "undefined")
	global.DrawDeviceForSteam = global.Window.BasicDrawDevice;

// Mojimo (Morisawa) game fonts come out of a plugin; the player's font stands in for them.
if (typeof(global.ExtractMojimoGameFont) === "undefined")
	global.ExtractMojimoGameFont = function() { return false; };

// Games written for KiriKiri 2 build some menus only there (@if (!kirikiriz)) and use them
// anyway, e.g. lass_pixy's dispDoubleBufferMenu: windows have a menu nobody sees for them.
{
	// under a parent of their own, as scripts move them elsewhere (menu.parent.remove(menu))
	var hidden = new MenuItem(null, "");
	hidden.visible = false;
	var names = [ "dispDoubleBufferMenu", "useDoubleBufferMenuItem" ];
	for (var i = 0; i < names.count; i++)
		if (typeof(global.Window[names[i]]) === "undefined") {
			var item = new MenuItem(null, "");
			hidden.add(item);
			global.Window[names[i]] = item;
		}
}
